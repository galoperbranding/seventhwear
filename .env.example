# SEVENTHWEAR Environment Variables
# Copy this file to .env.local and fill in the values

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=SEVENTHWEAR

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_MODE=sandbox

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@seventhwear.com
SMTP_PASS=your-app-password
EMAIL_FROM=SEVENTHWEAR <hello@seventhwear.com>

# Admin (first admin credentials)
ADMIN_EMAIL=hello@seventhwear.com
ADMIN_PASSWORD=change-this-password

# Database
DATABASE_PATH=./data/seventhwear.db
