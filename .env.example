# ═══════════════════════════════════════════════════════
# SEVENTHWEAR — Environment Variables
# ═══════════════════════════════════════════════════════
# Copiar a .env.local y rellenar valores reales

# ─── App ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=SEVENTHWEAR

# ─── JWT Secret ───────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ─── PayPal ───────────────────────────────────────────
# sandbox | live
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_MODE=sandbox

# ─── Email (SMTP) ────────────────────────────────────
# Gmail: activar 2FA → crear App Password
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@seventhwear.com
SMTP_PASS=your-app-password
EMAIL_FROM=SEVENTHWEAR <hello@seventhwear.com>

# ─── Admin (solo seed.js) ────────────────────────────
ADMIN_EMAIL=hello@seventhwear.com
ADMIN_PASSWORD=change-this-password

# ─── Database ─────────────────────────────────────────
DATABASE_PATH=./data/seventhwear.db
