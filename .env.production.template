# ═══════════════════════════════════════════════════════
# SEVENTHWEAR — Production Environment Variables
# ═══════════════════════════════════════════════════════
# Copiar a .env.local en el servidor y rellenar valores

# ─── App ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.seventhwear.com
NEXT_PUBLIC_SITE_NAME=SEVENTHWEAR
NODE_ENV=production

# ─── JWT Secret ───────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_CLAVE_SEGURA_64_CHARS_MINIMO

# ─── PayPal (LIVE) ───────────────────────────────────
PAYPAL_CLIENT_ID=TU_PAYPAL_LIVE_CLIENT_ID
PAYPAL_CLIENT_SECRET=TU_PAYPAL_LIVE_SECRET
NEXT_PUBLIC_PAYPAL_CLIENT_ID=TU_PAYPAL_LIVE_CLIENT_ID
PAYPAL_MODE=live

# ─── Email (SMTP) ────────────────────────────────────
# Para Gmail: activar 2FA y crear App Password en
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@seventhwear.com
SMTP_PASS=TU_APP_PASSWORD_DE_GMAIL
EMAIL_FROM=SEVENTHWEAR <hello@seventhwear.com>

# ─── Admin ────────────────────────────────────────────
# Solo se usa en seed.js para crear el primer admin
# Después de ejecutar seed, cambiar contraseña
ADMIN_EMAIL=hello@seventhwear.com
ADMIN_PASSWORD=CAMBIAR_CONTRASEÑA_SEGURA

# ─── Database ─────────────────────────────────────────
DATABASE_PATH=./data/seventhwear.db
